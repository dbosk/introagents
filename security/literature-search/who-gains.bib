@article{Caplin2026ABCs,
  author = {Caplin, Andrew and Deming, David and Li, Shangwen and Martin, Daniel and Marx, Philip and Weidmann, Ben and Ye, Kadachi Jiada},
  title = {The {ABCs} of Who Benefits from Working with {AI}: Ability, Beliefs, and Calibration},
  journal = {Management Science},
  year = {2026},
