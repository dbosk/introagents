\subsection{The main program}\label{bot:record-main}

[[main]] records the rounds and modes asked for, writes the working
attacks, the excerpts and the two summaries, and finishes with a run
log: the model, what the run spent, and whether a [[logs.db]] appeared in [[llm]]'s user directory, which
\cref{bot:model} says the Python API never writes.

<<recording functions>>=
def main():
    """Record the transcripts."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    parser.add_argument("--rounds", default="1a,1b,2,3")
    parser.add_argument("--modes", default="vulnerable,hardened")
    parser.add_argument("--repeats", type=int, default=3)
    parser.add_argument("--repeats-for", default="", help="e.g. 3=10")
    parser.add_argument("--max-cost", type=float, default=1.00)
    parser.add_argument("--out", default="/opt/transcripts")
    parser.add_argument("--tag", default="")
    parser.add_argument("--no-files", action="store_true")
    args = parser.parse_args()
    key = take_api_key()
    model = llm.get_model(args.model)
    out = pathlib.Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    tag = f"{args.tag}-" if args.tag else ""
    spent = {"cost": 0.0, "input": 0, "output": 0, "max": args.max_cost}
    repeats = {name: args.repeats for name in args.rounds.split(",")}
    for item in filter(None, args.repeats_for.split(",")):
        name, count = item.split("=")
        repeats[name] = int(count)
    results, tries = {}, {}
    for round_name in args.rounds.split(","):
        for mode in args.modes.split(","):
            hardened = mode == "hardened"
            results[(round_name, hardened)], tries[(round_name, hardened)] = (
                record_round(
                    model,
                    key,
                    round_name,
                    hardened,
                    repeats[round_name],
                    out,
                    tag,
                    spent,
                )
            )
            print(round_name, mode, results[(round_name, hardened)])
    write_working_attacks(results, model.model_id, repeats, out, tag)
    write_slides(results, tries, model.model_id, out, tag)
    write_summary(results, model.model_id, repeats, out, tag)
    write_compact_summary(results, model.model_id, repeats, out, tag)
    if not args.no_files:
        record_files(model, key, out, tag, spent)
    <<write the run log>>
