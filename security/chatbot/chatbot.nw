def open_round(self, name):
    """Open round `name`, or close the chat if `name` is None."""
    if name is not None and name not in ROUNDS:
        raise ValueError(f"No round {name!r}")
    with self.lock:
        self.round = name

def set_hardened(self, hardened):
    """Switch between the vulnerable and the hardened bot."""
    with self.lock:
        self.hardened = hardened

def epoch(self):
    """Return the pair of round and mode that conversations belong to."""
    return (self.round, self.hardened)
