    assert "8 of 40" in lines[6] and "1 of 40" in lines[6]


def test_excerpt_leaves_out_ordinary_reviews():
    attack = record.ATTACKS["3"][1]
    review = attack["review"]
    said = [("Review", text) for text in record.BENIGN_REVIEWS[:2]]
    said += [("Review", review), ("Mo", "Arr, a summary"), ("Result", "ok")]
    lines = "\n".join(
        record.excerpt_lines({"attack": attack, "said": said}, record.cast())
    )
    assert record.BENIGN_REVIEWS[0][:20] not in lines
    assert "not shown" in lines and "Arr, a summary" in lines
    assert lines.count("Review:") == 2


def test_slide_fits_or_says_it_was_cut(tmp_path):
    attack = record.ATTACKS["1a"][0]
    short = {"attack": attack, "said": [("You", "hi"), ("Mo", "x " * 60)]}
    long = {"attack": attack, "said": [("You", "hi"), ("Mo", "y " * 400)]}
    values = record.cast()
    longer = {"attack": attack, "said": [("You", "hi"), ("Mo", "z " * 800)]}
    assert record.choose([long], [short], values) is short
    assert record.choose([longer, long], [], values) is long
    path = tmp_path / "slide.txt"
    record.write_slide(path, "Model: m", record.choose([long], [], values), values)
    lines = path.read_text().splitlines()
    assert len(lines) <= record.SLIDE_LINES
    assert max(map(len, lines)) <= record.SLIDE_WIDTH
    assert lines[-1] == record.CONTINUES
    record.write_slide(path, "Model: m", None, values)
    assert not path.exists()
