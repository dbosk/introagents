ROUND_MESSAGES = 1000
MIN_MESSAGES_PER_PHONE = 5
MAX_MESSAGES_PER_PHONE = 30
ROUND_BUDGET_PER_STUDENT = 0.02
TOTAL_BUDGET = 10.00
MIN_IN_FLIGHT = 2
MAX_IN_FLIGHT = 25
STUDENTS_PER_CALL = 4
SESSIONS_PER_STUDENT = 3
REVIEWS_PER_PHONE = 3
