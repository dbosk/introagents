\subsection{Testing the servers over HTTP}\label{bot:server-tests}

The routing tests run both servers for real on the loopback address,
on ports the operating system picks, and send raw requests with
[[http.client]], which sends the path exactly as given: a browser would
clean up [[/../]] before sending, an attacker's tool does not.

<<test functions>>=
@pytest.fixture
def servers():
    bot = make_bot()
    phone, dashboard = make_servers(bot, "127.0.0.1", 0, 0)
    for server in (phone, dashboard):
        threading.Thread(target=server.serve_forever, daemon=True).start()
    yield bot, phone, dashboard
    for server in (phone, dashboard):
        server.shutdown()
        server.server_close()


def request(server, method, path, body=None, headers=None):
    host, port = server.server_address[:2]
    connection = http.client.HTTPConnection(host, port, timeout=5)
    connection.request(method, path, body=body, headers=headers or {})
    response = connection.getresponse()
    response.read()
    connection.close()
    return response


@pytest.mark.parametrize(
    "path",
    [
        "/etc/passwd",
        "/../../etc/passwd",
        "/%2e%2e/%2e%2e/etc/passwd",
        "//etc/passwd",
        "/chatbot.py",
        "/.venv/pyvenv.cfg",
    ],
)
def test_no_path_reaches_a_file(servers, path):
    bot, phone, dashboard = servers
    assert request(phone, "GET", path).status == 404
    assert request(dashboard, "GET", path).status == 404


def test_page_sets_a_signed_cookie(servers):
    bot, phone, _ = servers
    response = request(phone, "GET", "/")
    assert response.status == 200
    cookie = response.getheader("Set-Cookie").split(";")[0].split("=", 1)[1]
    assert bot.session_for(cookie) is not None


def test_chat_posts_redirect_with_status(servers):
    bot, phone, _ = servers
    form = {"Content-Type": "application/x-www-form-urlencoded"}
    response = request(phone, "POST", "/chat", "message=hi", form)
    assert response.status == 303
    assert response.getheader("X-Bot-Status") == "closed"
    huge = "message=" + "x" * (MAX_BODY + 1)
    assert request(phone, "POST", "/chat", huge, form).status == 413
    for length in ("-5", "many", "\u00b2"):
        bad = {**form, "Content-Length": length}
        assert request(phone, "POST", "/chat", "", bad).status == 400


def test_dashboard_is_loopback_only_and_needs_the_token(servers):
    bot, phone, dashboard = servers
    _, wide = make_servers(bot, "0.0.0.0", 0, 0)
    assert wide.server_address[0] == "127.0.0.1"
    wide.server_close()
    form = {"Content-Type": "application/x-www-form-urlencoded"}
    for wrong in ("wrong", "%C3%A9"):
        body = f"action=round&value=1a&token={wrong}"
        assert request(dashboard, "POST", "/action", body, form).status == 403
    assert bot.round is None
    body = f"action=round&value=1a&token={dashboard.token}"
    assert request(dashboard, "POST", "/action", body, form).status == 303
    assert bot.round == "1a"
