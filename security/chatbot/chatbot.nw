    assert session.messages == 1
    assert bot.meter.calls == 1
    expected = (FAKE_INPUT * 1 + FAKE_OUTPUT * 5) / 1e6
    assert bot.meter.cost("1a") == pytest.approx(expected)
    assert bot.leaked_sessions == {session.id}
