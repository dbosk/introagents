    assert prompt_vulnerable.STAFF_CODE in system
    assert "Great jam" in text and "refund A1001" in text
    assert "Not approved" not in text
    assert [t.name for t in tools] == ["lookup_order", "refund"]
    bot.set_hardened(True)
    system, text, tools = bot.summary_request()
    assert prompt_vulnerable.STAFF_CODE not in system
    assert tools == []
    assert text.count("<review>") == 2
    assert text.count("</review>") == 2
    assert "&lt;/review&gt;" in text
