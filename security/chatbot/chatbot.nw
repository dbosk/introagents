<<functions>>=
def clamp(value, low, high):
    """Return `value` moved into the interval from `low` to `high`."""
    return max(low, min(high, value))


def limits_for(students, total_budget=TOTAL_BUDGET):
    """Return the `Limits` for a room of `students` students."""
    if students < 1:
        raise ValueError("There must be at least one student.")
    return Limits(
        students=students,
        messages_per_phone=clamp(
            ROUND_MESSAGES // students,
            MIN_MESSAGES_PER_PHONE,
            MAX_MESSAGES_PER_PHONE,
        ),
        reviews_per_phone=REVIEWS_PER_PHONE,
        round_budget=students * ROUND_BUDGET_PER_STUDENT,
        total_budget=total_budget,
        in_flight=clamp(
            students // STUDENTS_PER_CALL, MIN_IN_FLIGHT, MAX_IN_FLIGHT
        ),
        max_sessions=students * SESSIONS_PER_STUDENT,
    )
@

