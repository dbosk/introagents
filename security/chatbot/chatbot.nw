[[main]] prints where phones go and where the dashboard is, serves
until interrupted, and prints the meter on the way out, so the final
bill is on the terminal even after the dashboard is gone.

<<functions>>=
def main(argv=None):
    """Start the bot."""
    args = parse_args(argv)
    if args.print_url:
        print(phone_url(args))
        return
    key = take_api_key()
    model = llm.get_model(args.model)
    bot = Bot(model, key, limits_for(args.students, args.budget), args.hardened)
    if args.round:
        bot.open_round(args.round)
    phone, dashboard = make_servers(bot, args.host, args.port, args.dashboard_port)
    threading.Thread(target=dashboard.serve_forever, daemon=True).start()
    limits = bot.limits
    print(f"Model: {model.model_id}, {limits.students} students")
    print(
        f"Per phone and round: {limits.messages_per_phone} messages; "
        f"round budget ${limits.round_budget:.2f}, "
        f"total ${limits.total_budget:.2f}, {limits.in_flight} calls at once"
    )
    print(f"Phones:    {phone_url(args)}")
    print(f"Dashboard: http://127.0.0.1:{args.dashboard_port}/  (laptop only)")
    try:
        phone.serve_forever()
    except KeyboardInterrupt:
        pass
    s = bot.stats()
    print(
        f"\nSpent ${s['cost']:.4f}: {s['input_tokens']} tokens in, "
        f"{s['output_tokens']} out, {s['calls']} calls."
    )
