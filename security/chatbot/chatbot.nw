def test_limits_scale_with_students():
    small, usual, large = limits_for(10), limits_for(100), limits_for(400)
    assert small.messages_per_phone == 30
    assert usual.messages_per_phone == 10
    assert large.messages_per_phone == 5
    assert small.round_budget < usual.round_budget < large.round_budget
    assert usual.round_budget == pytest.approx(100 * ROUND_BUDGET_PER_STUDENT)
    assert (small.in_flight, usual.in_flight, large.in_flight) == (2, 25, 25)
